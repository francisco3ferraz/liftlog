# Local development environment. Copy to .env (git-ignored) and adjust if needed.
# Every value has a default in docker-compose.yml and application-local.yml,
# so the local stack also runs without a .env file.

# Postgres (docker-compose.yml service "postgres"; read by application-local.yml)
POSTGRES_DB=liftlog
POSTGRES_USER=liftlog
POSTGRES_PASSWORD=liftlog
# Host port, bound to 127.0.0.1 only
POSTGRES_PORT=5432

# Mailpit (docker-compose.yml service "mailpit"; host ports bound to 127.0.0.1 only)
# SMTP port the backend sends to
MAILPIT_SMTP_PORT=1025
# Web UI for reading captured mail: http://localhost:8025
MAILPIT_UI_PORT=8025
