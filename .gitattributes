# Normalise line endings; Windows batch files keep CRLF.
* text=auto eol=lf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.ico binary
*.webp binary
*.woff2 binary

# Generated files: collapsed in GitHub diffs and excluded from language stats.
# They are still committed and reviewed.
api/openapi.json linguist-generated=true
frontend/src/lib/api/schema.d.ts linguist-generated=true
frontend/pnpm-lock.yaml linguist-generated=true
